# Firebase config for cloud sync. Copy to .env.local and fill in from your
# Firebase project's settings (Project settings -> General -> Your apps).
# Without these the app runs purely local, which is a full mode, not an error.
# See docs/firebase-setup.md for the five-minute setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
